# One invocation of run_case.sh owns one freshly initialized XRocksCache data directory.
# 每次 run_case.sh 应对应一个全新的 XRocksCache 数据目录。
XRC_ADDR=127.0.0.1:6666
DATASET_SIZE=10GiB
VALUE_SIZE=1KiB
LOAD_DATASET=yes
LOAD_CLIENTS=8
PIPELINE=64
CLIENTS=16
DURATION=5m
WARMUP=30s
REPORT_INTERVAL=10s
READ_RATIOS="95"
DISTRIBUTIONS="zipfian"
TARGET_QPS_VALUES="10000"
RESULT_ROOT=./results
